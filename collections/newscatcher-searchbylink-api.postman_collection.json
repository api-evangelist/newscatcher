          "name": "Search articles by links or IDs",
          "request": {
            "name": "Search articles by links or IDs",
            "description": {
              "content": "Searches for articles based on specified links or IDs. You can filter results by date range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "search_by_link"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "The Newscatcher article ID (corresponds to the `_id` field in API response) or a list of article IDs to search for. To specify multiple IDs, use a comma-separated string. \n\n**Caution**: You can use either the `links` or the `ids` parameter, but not both at the same time.\n"
                },
                {
                  "disabled": false,
                  "key": "links",
                  "value": "<string>",
                  "description": "The article link or list of article links to search for. To specify multiple links, use a comma-separated string.\n\n**Caution**: You can use either the `links` or the `ids` parameter, but not both at the same time.\n"
                },
                {
                  "disabled": false,
                  "key": "from_",
                  "value": "1 month ago"
                },
                {
                  "disabled": false,
                  "key": "to_",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1"
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "100"
                },
                {
